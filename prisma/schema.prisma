generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  onboarded Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessment  Assessment?
  paths       UserPath[]
  skillGaps   SkillGap[]
  resumes     Resume[]
  applications JobApplication[]
  internships   UserInternship[]
  analysis    CareerAnalysis?
  panelQuestions PanelQuestion[]
}

model PanelQuestion {
  id       String   @id @default(cuid())
  userId   String
  question String
  askedAt  DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Assessment {
  id           String   @id @default(cuid())
  userId       String   @unique
  skills       String   @default("[]")
  interests    String   @default("[]")
  personality  String   @default("{}")
  values       String   @default("[]")
  workStyle    String   @default("hybrid")
  education    String   @default("")
  experience   String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CareerPath {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  description     String
  salaryMin       Int
  salaryMax       Int
  growthOutlook   String   @default("stable") // declining, stable, growing, booming
  aiRisk          String   @default("medium") // none, low, medium, high, critical
  aiRiskScore     Float    @default(0.5) // 0.0 - 1.0
  requiredSkills  String   @default("[]")
  industries      String   @default("[]")
  educationLevel  String   @default("bachelors")
  timeToEntry     String   @default("4 years")
  keyTasks        String   @default("[]")
  futureOutlook   String   @default("")
  createdAt       DateTime @default(now())

  users UserPath[]
}

model UserPath {
  id           String   @id @default(cuid())
  userId       String
  careerPathId String
  matchScore   Float    @default(0)
  skillMatch   Float    @default(0)
  interestMatch Float   @default(0)
  aiSafetyScore Float   @default(0)
  rank         Int      @default(0)
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerPath CareerPath @relation(fields: [careerPathId], references: [id], onDelete: Cascade)

  @@unique([userId, careerPathId])
}

model SkillGap {
  id            String   @id @default(cuid())
  userId        String
  skillName     String
  currentLevel  Int      @default(0) // 0-10
  requiredLevel Int      @default(5) // 0-10
  gap           Int      @default(5)
  learningPath  String   @default("[]")
  priority      String   @default("medium") // low, medium, high
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillName])
}

// Cached AI-generated deep analysis for a user's career profile
model CareerAnalysis {
  id        String   @id @default(cuid())
  userId    String   @unique
  analysis  String   @default("{}") // JSON payload, see /api/analysis
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resume {
  id              String   @id @default(cuid())
  userId          String
  fileName        String
  extractedSkills String   @default("[]")
  experience      String   @default("")
  education       String   @default("")
  summary         String   @default("")
  createdAt       DateTime @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications JobApplication[]
}

model JobApplication {
  id          String   @id @default(cuid())
  userId      String
  resumeId    String?
  jobId       String
  jobTitle    String
  company     String
  location    String
  status      String   @default("applied") // applied, sent, pending, rejected, interview
  appliedAt   DateTime @default(now())
  autoApplied Boolean  @default(false)
  coverLetter String   @default("")
  emailDraft  String   @default("")
  matchScore  Float    @default(0)
  notes       String   @default("")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)
}

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  industry    String
  headquarters String
  size        String   @default("1000+")
  founded    Int      @default(2000)
  rating     Float    @default(4.0)
  culture    String   @default("")
  benefits   String   @default("[]")
  salaryRange String  @default("")
  growthRate String   @default("stable")
  techStack  String   @default("[]")
  description String  @default("")
  website    String   @default("")
  logo       String   @default("")
  createdAt  DateTime @default(now())

  mentors Mentor[]
}

model Mentor {
  id          String   @id @default(cuid())
  name        String
  title       String
  company     String
  companyId   String?
  experience  Int      @default(5)
  skills      String   @default("[]")
  bio         String   @default("")
  linkedin    String   @default("")
  available   Boolean  @default(true)
  rating      Float    @default(4.5)
  mentees     Int      @default(0)
  createdAt   DateTime @default(now())

  companyRef Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userMatches UserMentor[]
}

model UserMentor {
  id        String   @id @default(cuid())
  userId    String
  mentorId  String
  status    String   @default("pending") // pending, accepted, rejected
  message   String   @default("")
  createdAt DateTime @default(now())

  mentor Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@unique([userId, mentorId])
}

model WeeklyReport {
  id              String   @id @default(cuid())
  userId          String
  weekStart       DateTime
  weekEnd         DateTime
  applicationsSent Int     @default(0)
  interviewsScheduled Int @default(0)
  skillsImproved  String   @default("[]")
  newMatches      Int      @default(0)
  topCareerMatch  String   @default("")
  summary         String   @default("")
  recommendations String   @default("[]")
  createdAt       DateTime @default(now())

  @@unique([userId, weekStart])
}

model Internship {
  id              String   @id @default(cuid())
  title           String
  company         String
  companyLogo     String   @default("")
  location        String
  city            String   @default("")
  country         String   @default("India")
  type            String   @default("paid") // paid, unpaid, stipend
  stipend         String   @default("")
  stipendMin      Int      @default(0)
  stipendMax      Int      @default(0)
  currency        String   @default("INR")
  duration        String   @default("3 months")
  durationWeeks   Int      @default(12)
  workMode        String   @default("hybrid") // remote, hybrid, onsite
  domain          String   @default("")
  description     String   @default("")
  requirements    String   @default("[]")
  skillsRequired  String   @default("[]")
  applyUrl        String   @default("")
  deadline        DateTime?
  startDate       DateTime?
  openings        Int      @default(1)
  isPPO           Boolean  @default(false)
  isCertified     Boolean  @default(true)
  isWomenOnly     Boolean  @default(false)
  isGovt          Boolean  @default(false)
  difficulty      String   @default("medium") // easy, medium, hard
  acceptanceRate  Float    @default(0.3)
  competitionLevel String  @default("medium") // low, medium, high, extreme
  companyRating   Float    @default(4.0)
  internshipRating Float   @default(4.0)
  mentorAvailable Boolean  @default(true)
  lorAvailable    Boolean  @default(false)
  visaSponsorship Boolean  @default(false)
  source          String   @default("curated")
  category        String   @default("tech") // tech, startup, fortune500, government, research
  hiringSpeed     String   @default("normal") // fast, normal, slow
  techStack       String   @default("[]")
  interviewRounds Int      @default(3)
  createdAt       DateTime @default(now())

  users UserInternship[]
}

model UserInternship {
  id              String   @id @default(cuid())
  userId          String
  internshipId    String
  status          String   @default("saved") // saved, applied, shortlisted, assessment, interview, rejected, offer, accepted, withdrawn
  matchScore      Float    @default(0)
  appliedAt       DateTime?
  notes           String   @default("")
  createdAt       DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@unique([userId, internshipId])
}
